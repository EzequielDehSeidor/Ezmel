# --- Supabase (Project Settings > API) -------------------------------------------
# Mientras estas dos variables no estén seteadas, la app corre en modo mock SOLO en
# desarrollo (login falso, datos en memoria). En producción (Netlify) son obligatorias:
# si faltan, la app corta con un error en vez de abrirse sin login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- URL pública de la app (recomendado en producción) ---------------------------
# Se usa para los links de confirmación de email y los redirects de login.
# Local:    http://localhost:3000
# Netlify:  https://tu-sitio.netlify.app   (o tu dominio propio)
NEXT_PUBLIC_SITE_URL=

# NO cargues acá la "service_role key" de Supabase: la app no la necesita y, si se
# filtra, saltea todas las reglas de seguridad.
